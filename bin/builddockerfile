#!/bin/bash

if [[ -z "$1" || "$1" == "--help" || "$1" == "-h" ]]
then
    echo "Usage: $0 <php-base-tag> [extension1 extension2 ...]"
    echo "Example: $0 8.5-fpm bcmath zip"
    exit 0
fi

BASE=$1
IS_APK=
if [[ $BASE == *"alpine"* ]]
then
    IS_APK=1
fi


# Get the extensions that are requested for the dockerfile.
# Sort them and remove duplicates.
REQUESTED_EXTENSIONS=$(echo "${@:2}" | xargs -n1 | sort -u | xargs)

# Get the script's directory.
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
EXTENSIONS_DIR="$SCRIPT_DIR/../extensions"

# Version-dependent extension configs can read these.
PHP_VERSION=$("$SCRIPT_DIR/php-version" "$BASE")

# True when the base image's PHP is older than the given major.minor version.
php_version_lt() {
    [[ "$PHP_VERSION" != "$1" && "$(printf '%s\n' "$PHP_VERSION" "$1" | sort -V | head -n1)" == "$PHP_VERSION" ]]
}

# PHP 8.5+ installs PECL extensions with PIE, which replaces pecl (the 8.6
# images no longer ship pecl at all). A version-less tag tracks the newest PHP.
# The pecl path only serves PHP 8.4, whose active support ends 2026-12-31;
# remove it (and PECL_INSTALL) once 8.4 is dropped.
USE_PIE=
if [[ -z "$PHP_VERSION" ]] || ! php_version_lt 8.5; then
    USE_PIE=1
fi

# Aggregation variables
ALL_SYS_DEPS=""
ALL_PHP_EXT_INSTALL=""
ALL_PECL_INSTALL=""
ALL_PIE_INSTALL=""
ALL_PHP_EXT_ENABLE=""
ALL_CUSTOM_CONTENTS=""

for I in $REQUESTED_EXTENSIONS
do
    EXT_DIR="$EXTENSIONS_DIR/$I"
    CONFIG_FILE="$EXT_DIR/config"

    if [[ ! -d "$EXT_DIR" ]]
    then
        echo "Unsupported extension $I (directory missing)" >&2
        exit 1
    fi

    if [[ -f "$CONFIG_FILE" ]]
    then
        # Reset variables before sourcing
        APT_DEPS=""
        APK_DEPS=""
        PHP_EXT_INSTALL=""
        PECL_INSTALL=""
        PIE_INSTALL=""
        PHP_EXT_ENABLE=""
        DOCKERFILE_CONTENTS=""

        # Source the config file
        source "$CONFIG_FILE"

        # Aggregate system dependencies
        if [[ -n "$IS_APK" ]]; then
            ALL_SYS_DEPS="$ALL_SYS_DEPS $APK_DEPS"
        else
            ALL_SYS_DEPS="$ALL_SYS_DEPS $APT_DEPS"
        fi

        ALL_PHP_EXT_INSTALL="$ALL_PHP_EXT_INSTALL $PHP_EXT_INSTALL"
        if [[ -n "$USE_PIE" ]]; then
            if [[ -n "$PECL_INSTALL" && -z "$PIE_INSTALL" ]]; then
                echo "Extension $I sets PECL_INSTALL but no PIE_INSTALL, which PHP $PHP_VERSION needs" >&2
                exit 1
            fi
            ALL_PIE_INSTALL="$ALL_PIE_INSTALL $PIE_INSTALL"
        else
            ALL_PECL_INSTALL="$ALL_PECL_INSTALL $PECL_INSTALL"
        fi
        ALL_PHP_EXT_ENABLE="$ALL_PHP_EXT_ENABLE $PHP_EXT_ENABLE"
        
        if [[ -n "$DOCKERFILE_CONTENTS" ]]; then
            ALL_CUSTOM_CONTENTS="$ALL_CUSTOM_CONTENTS"$'\n\n'"# Custom setup for $I"$'\n'"$DOCKERFILE_CONTENTS"
        fi
    else
        # For migration: if config doesn't exist, we might want to warn or skip.
        # The plan says it will produce empty output for now.
        echo "# Warning: No config file found for $I"
    fi
done

# Deduplicate and sort lists
ALL_PHP_EXT_INSTALL=$(echo "$ALL_PHP_EXT_INSTALL" | xargs -n1 | sort -u | xargs)
ALL_PECL_INSTALL=$(echo "$ALL_PECL_INSTALL" | xargs -n1 | sort -u | xargs)
ALL_PIE_INSTALL=$(echo "$ALL_PIE_INSTALL" | xargs -n1 | sort -u | xargs)

# PIE downloads extensions as zip archives (Debian lacks unzip; busybox's is
# enough on Alpine) and warns without libtoolize.
if [[ -n "$ALL_PIE_INSTALL" ]]; then
    if [[ -n "$IS_APK" ]]; then
        ALL_SYS_DEPS="$ALL_SYS_DEPS libtool"
    else
        ALL_SYS_DEPS="$ALL_SYS_DEPS libtool unzip"
    fi
fi
ALL_PHP_EXT_ENABLE=$(echo "$ALL_PHP_EXT_ENABLE" | xargs -n1 | sort -u | xargs)

ALL_SYS_DEPS=$(echo "$ALL_SYS_DEPS" | xargs -n1 | sort -u | xargs)

# Output Dockerfile
echo "FROM php:$BASE"

# 1. System Dependencies
if [[ -n "$ALL_SYS_DEPS" ]]; then
    echo -e "\n# Setup system dependencies"
    if [[ -n "$IS_APK" ]]; then
        echo "RUN apk add --no-cache $ALL_SYS_DEPS"
    else
        echo "RUN apt-get update -q \\"
        echo "    && apt-get install -y -q --no-install-recommends $ALL_SYS_DEPS \\"
        echo "    && apt-get autoremove -y -q \\"
        echo "    && apt-get clean -q \\"
        echo "    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*"
    fi
fi

# 2. PHP Extensions
if [[ -n "$ALL_PHP_EXT_INSTALL" ]]; then
    echo -e "\n# Install PHP extensions"
    echo "RUN docker-php-ext-install $ALL_PHP_EXT_INSTALL"
fi

# 3. PECL Extensions
if [[ -n "$ALL_PECL_INSTALL" ]]; then
    echo -e "\n# Install PECL extensions"
    echo "RUN pecl install $ALL_PECL_INSTALL"
fi

# 3b. PIE Extensions (enabling is left to step 4)
if [[ -n "$ALL_PIE_INSTALL" ]]; then
    echo -e "\n# Install PECL extensions with PIE"
    echo "COPY --from=ghcr.io/php/pie:1-bin /pie /usr/bin/pie"
    echo "RUN pie install -n --skip-enable-extension $ALL_PIE_INSTALL \\"
    echo "    && rm -rf /root/.pie /root/.composer/cache"
fi

# 4. Enable Extensions
if [[ -n "$ALL_PHP_EXT_ENABLE" ]]; then
    echo -e "\n# Enable PHP extensions"
    echo "RUN docker-php-ext-enable $ALL_PHP_EXT_ENABLE"
fi

# 5. Custom Contents
if [[ -n "$ALL_CUSTOM_CONTENTS" ]]; then
    echo "$ALL_CUSTOM_CONTENTS"
fi

echo ""
